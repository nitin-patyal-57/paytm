# FuelPay backend configuration — copy to .env and adjust.
# Never commit real credentials.

# HTTP port
PORT=3000
NODE_ENV=development

# PostgreSQL connection. Leave empty to use the in-memory store
# (convenient, but transactions are lost on restart).
# Example: postgresql://postgres:password@localhost:5432/fuelpay
DATABASE_URL=

# CORS origins (comma separated) — '*' is fine for the demo LAN setup.
CORS_ORIGINS=*

# Payment provider: 'demo' (default, simulated) or 'paytm' (future integration).
PAYMENT_PROVIDER=demo
DEMO_PAYMENTS_ENABLED=true

# Minutes before a non-terminal transaction is marked EXPIRED.
PENDING_TTL_MINUTES=30

# ---- Reserved for a future approved Paytm merchant integration ----
# Do NOT fill these in for the demo. See docs/paytm-integration.md.
# PAYTM_MID=
# PAYTM_KEY=
# PAYTM_BASE_URL=
# PAYTM_WEBSITE=
# PAYTM_CALLBACK_URL=
